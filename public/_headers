# Cloudflare Pages cache-policy
# Format: pattern \n  HeaderName: value
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML — alltid friskt så strukturendringer propagerer umiddelbart.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Astros fingeravtrykk-hashede bundle-filer (CSS/JS/fonts).
# Hashen endres når innholdet endres, så vi kan trygt ha lang cache.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# App-ikoner. Én dag før vi sjekker etter nytt innhold.
# Hvis du bytter ut et ikon og vil at det skal slå igjennom raskere,
# bump v-en i `iconPath` i src/data/apps.ts (f.eks. /icons/foo.png?v=2).
/icons/*
  Cache-Control: public, max-age=86400, must-revalidate

# Skjermbilder og hero-video endres sjelden. 30 dager i cache; bytter du
# ut en fil, bruk samme v-bump-triks som ikonene (?v=2 på referansen).
/screenshots/*
  Cache-Control: public, max-age=2592000, must-revalidate

/video/*
  Cache-Control: public, max-age=2592000, must-revalidate

# Selvhostede fonter. Byttes aldri uten nytt filnavn.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# OG-kort (delingsbilder). En uke, samme v-bump-triks ved utskifting.
/og/*
  Cache-Control: public, max-age=604800, must-revalidate

# Apple App Site Association — universal links for Hyttepermen-appen.
# Apple krever application/json på fila (som ikke har filendelse) og
# at den serveres uten redirect. Test etter deploy:
#   curl -i https://haugogdatter.no/.well-known/apple-app-site-association
/.well-known/apple-app-site-association
  Content-Type: application/json

# Sikkerhets-headers på alt
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

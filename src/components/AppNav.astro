---
/**
 * AppNav — sub-nav nederst på hver app-side. Markerer aktiv side
 * med aria-current="page" som CSS-en bruker for understreking.
 */
interface Props {
  slug: string;
  current?: 'oversikt' | 'personvern' | 'vilkar' | 'support';
}
const { slug, current } = Astro.props;
const items = [
  { id: 'oversikt',   href: `/${slug}`,             label: 'Oversikt' },
  { id: 'personvern', href: `/${slug}/personvern`,  label: 'Personvern' },
  { id: 'vilkar',     href: `/${slug}/vilkar`,      label: 'Vilkår' },
  { id: 'support',    href: `/${slug}/support`,     label: 'Support' },
] as const;
---
<nav class="app-nav" aria-label="Sider for denne appen">
  {items.map((item) => (
    <a href={item.href} aria-current={current === item.id ? 'page' : undefined}>{item.label}</a>
  ))}
</nav>

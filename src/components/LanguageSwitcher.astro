---
/**
 * LanguageSwitcher — viser de språkene som faktisk finnes for gjeldende
 * side. Alle sider har NO og EN; Plantekn-sidene har i tillegg DE og JA.
 * Lista kommer fra localesForPath, så den utvider seg selv når flere
 * apper blir oversatt.
 */
import {
  resolveLocale,
  localesForPath,
  switchLocalePath,
  t,
  LOCALE_LABELS,
} from '../i18n/translations';

const locale = resolveLocale(Astro.currentLocale);
const strings = t(locale);
const others = localesForPath(Astro.url.pathname).filter((l) => l !== locale);
---
{others.map((l) => (
  <a
    class="lang-switch"
    href={switchLocalePath(Astro.url.pathname, l)}
    hreflang={l === 'no' ? 'nb-NO' : l}
    title={strings.langSwitcher.switchTo(LOCALE_LABELS[l])}
    aria-label={strings.langSwitcher.ariaLabel}
    data-target-locale={l}
  >
    {LOCALE_LABELS[l]}
  </a>
))}

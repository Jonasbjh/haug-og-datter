---
/**
 * NaturHero — levende natur-hero på forsiden. Fullskjerms video av en
 * tåkete norsk fjord bak segl, tittel, lede, knapper og en stille
 * tall-rad nederst. Videoen pauses når den er utenfor viewport og ved
 * prefers-reduced-motion; poster-bildet står da stille i stedet.
 *
 * Video: Pexels (Dominik Gryzbon), fri lisens uten kreditering.
 * Fil: public/video/hero-fjord.mp4 (720p, ~5,5 MB, 14 s loop).
 * Bytt video: legg ny mp4 + jpg i public/video/ og oppdater stiene her.
 */
import { resolveLocale } from '../i18n/translations';

const locale = resolveLocale(Astro.currentLocale);

const strings = {
  no: {
    lede: 'Apper laget med tid, tålmodighet og litt for mye kaffe.',
    logo: '/logo/haug-datter-skogen.svg?v=2',
    logoAlt: 'Haug & Datter — Drammen, Norge',
  },
  en: {
    lede: 'Apps built with time, patience, and a little too much coffee.',
    logo: '/logo/haug-datter-skogen-en.svg',
    logoAlt: 'Haug & Datter — Drammen, Norway',
  },
}[locale];
---
<section class="naturhero">
  {/* Plakaten er LCP-elementet på forsiden; preload gir den forsprang.
      Lenken står i body med vilje: Astro løfter ikke head fra komponenter. */}
  <link rel="preload" as="image" href="/video/hero-fjord-poster.webp" fetchpriority="high" />
  <div class="naturhero__media" aria-hidden="true">
    {/* Ingen <source> i markup: scriptet under legger den til bare på brede
        skjermer uten «spar data» og uten redusert bevegelse. Mobil får
        plakaten alene og slipper 5,5 MB video. */}
    <video
      data-naturhero-video
      data-src="/video/hero-fjord.mp4"
      muted
      loop
      playsinline
      preload="none"
      poster="/video/hero-fjord-poster.webp"
    ></video>
    <div class="naturhero__shade"></div>
    <div class="naturhero__korn"></div>
  </div>

  <div class="naturhero__inner">
    <img
      class="naturhero__segl"
      src={strings.logo}
      alt={strings.logoAlt}
      width="148"
      height="148"
      loading="eager"
      decoding="async"
    />
    <h1 class="naturhero__display" data-parallax-title>
      <span class="word">{[...'Haug'].map((ch) => <span class="ltr">{ch}</span>)}</span>
      {' '}
      <span class="amp">&amp;</span>
      {' '}
      <span class="word">{[...'Datter'].map((ch) => <span class="ltr">{ch}</span>)}</span>
    </h1>
    <p class="naturhero__lede">{strings.lede}</p>
  </div>

</section>

<script>
  // Videoen lastes bare der den er verdt 5,5 MB: brede skjermer, uten
  // «spar data» og uten prefers-reduced-motion. Ellers står plakaten.
  // Pauses dessuten utenfor viewport.
  const video = document.querySelector<HTMLVideoElement>('[data-naturhero-video]');
  if (video) {
    const mq = matchMedia('(prefers-reduced-motion: reduce)');
    const smal = matchMedia('(max-width: 719px)');
    const sparData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    const kanSpille = () => !mq.matches && !smal.matches && !sparData;

    const start = () => {
      if (!video.querySelector('source')) {
        const s = document.createElement('source');
        s.src = video.dataset.src ?? '';
        s.type = 'video/mp4';
        video.appendChild(s);
        video.load();
      }
      video.play().catch(() => {});
    };

    if (kanSpille()) start();
    mq.addEventListener?.('change', () => {
      if (mq.matches) video.pause();
      else if (kanSpille()) start();
    });

    const io = new IntersectionObserver(
      ([e]) => {
        if (!kanSpille()) return;
        if (e.isIntersecting) start();
        else video.pause();
      },
      { threshold: 0.05 }
    );
    io.observe(video);
  }
</script>

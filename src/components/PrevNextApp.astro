---
/**
 * PrevNextApp — to-kort-blokk nederst på app-sider, over sub-nav-en.
 * Looper sirkulært gjennom apps-rekkefølgen (siste app sin «neste»
 * peker tilbake til første). Klikk trigger accent-svep i den
 * destinasjons-appens farge via sweep-link-interceptor.
 */
import { siblings } from '../data/apps';
import { resolveLocale, t, localizedPath } from '../i18n/translations';

interface Props { slug: string }
const { slug } = Astro.props;
const { prev, next } = siblings(slug);
const locale = resolveLocale(Astro.currentLocale);
const strings = t(locale);
---
<nav class="siblings reveal" aria-label={strings.prevNext.otherApps}>
  <a class="prev" href={localizedPath(locale, `/${prev.slug}`)} style={`--sib-accent:${prev.accent}`}>
    <span class="lab">
      <span class="swatch-mini" aria-hidden="true"></span>
      {strings.prevNext.prev}
    </span>
    <span class="nm">{prev.name}</span>
    <span class="ar">{prev.tagline}</span>
  </a>
  <a class="next" href={localizedPath(locale, `/${next.slug}`)} style={`--sib-accent:${next.accent}`}>
    <span class="lab">
      <span class="swatch-mini" aria-hidden="true"></span>
      {strings.prevNext.next}
    </span>
    <span class="nm">{next.name}</span>
    <span class="ar">{next.tagline}</span>
  </a>
</nav>

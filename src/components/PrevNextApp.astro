---
/**
 * PrevNextApp — sluttblokka på oversikt-sidene: App Store-knapp (så
 * den som har lest seg gjennom slipper å scrolle tilbake til rail-en,
 * spesielt på mobil), eventuell «Fra verkstedet»-lenke for appen, og
 * forrige/neste-navigasjonen. Prev/next looper sirkulært gjennom
 * apps-rekkefølgen; klikk trigger accent-svep i destinasjons-appens
 * farge via sweep-link-interceptoren.
 */
import { siblings, getApp, getTagline } from '../data/apps';
import { resolveLocale, t, localizedPath } from '../i18n/translations';
import { getCollection } from 'astro:content';
import AppStoreBadge from './AppStoreBadge.astro';

interface Props { slug: string }
const { slug } = Astro.props;
const { prev, next } = siblings(slug);
const app = getApp(slug);
const locale = resolveLocale(Astro.currentLocale);
const strings = t(locale);

/* Nyeste verkstedsnotat for denne appen, i sidens språk (de/ja faller
 * til engelsk, samme som verkstedet-ruta gjør). */
const notatLang = locale === 'no' ? 'no' : 'en';
const notat = (await getCollection('verkstedet', (n) => n.data.lang === notatLang && n.data.app === slug))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const notatHref = notat
  ? `${localizedPath(locale, '/verkstedet')}#${notat.slug.split('/').pop()}`
  : null;
---
<div class="app-cta reveal">
  <AppStoreBadge app={app} />
  {notat && (
    <a class="app-cta__notat" href={notatHref}>
      <span class="app-cta__notat-label">{strings.nav.verkstedFra}</span>
      <em>{notat.data.title}</em>
    </a>
  )}
</div>

<nav class="siblings reveal" aria-label={strings.prevNext.otherApps}>
  <a class="prev" href={localizedPath(locale, `/${prev.slug}`)} style={`--sib-accent:${prev.accent}`}>
    <span class="lab">
      <span class="swatch-mini" aria-hidden="true"></span>
      {strings.prevNext.prev}
    </span>
    <span class="nm">{prev.name}</span>
    <span class="ar">{getTagline(prev, locale)}</span>
  </a>
  <a class="next" href={localizedPath(locale, `/${next.slug}`)} style={`--sib-accent:${next.accent}`}>
    <span class="lab">
      <span class="swatch-mini" aria-hidden="true"></span>
      {strings.prevNext.next}
    </span>
    <span class="nm">{next.name}</span>
    <span class="ar">{getTagline(next, locale)}</span>
  </a>
</nav>

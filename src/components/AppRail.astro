---
/**
 * AppRail — smal sticky venstrespalte som vises på alle app-undersider.
 * Inneholder iPhone-mockup, app-tittel, italic tagline, meta-linje
 * (swatch + hex + indeks), CTA-pille og sub-nav (Oversikt/Personvern/
 * Vilkår/Support).
 *
 * Bredden er bevisst 168–176px — bare så vidt bredere enn telefonen.
 * Høyre spalte (.app-flow) er der det meste skjer.
 */
import type { AppDef } from '../data/apps';
import { visibleApps, indexOf, getTagline } from '../data/apps';
import { resolveLocale, t, localizedPath } from '../i18n/translations';
import Phone from './Phone.astro';
import AppStoreBadge from './AppStoreBadge.astro';

interface Props {
  app: AppDef;
  current: 'oversikt' | 'personvern' | 'vilkar' | 'support';
}
const { app, current } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const strings = t(locale);
const idx = indexOf(app.slug);
const num = String(idx + 1).padStart(2, '0');
const total = String(visibleApps.length).padStart(2, '0');
const items = [
  { id: 'oversikt',   href: localizedPath(locale, `/${app.slug}`),             label: strings.appRail.oversikt },
  { id: 'personvern', href: localizedPath(locale, `/${app.slug}/personvern`),  label: strings.appRail.personvern },
  { id: 'vilkar',     href: localizedPath(locale, `/${app.slug}/vilkar`),      label: strings.appRail.vilkar },
  { id: 'support',    href: localizedPath(locale, `/${app.slug}/support`),     label: strings.appRail.support },
] as const;
---
<aside class="app-rail">
  <div class="app-rail__inner">
    <Phone app={app} />
    <h1 class="app-rail__name">{app.name}</h1>
    <p class="app-rail__tag">{getTagline(app, locale)}</p>
    <div class="app-rail__meta">
      <span class="swatch" aria-hidden="true"></span>
      <span class="hex">{app.accent.toUpperCase()}</span>
      {idx >= 0 && <span>· {num} / {total}</span>}
    </div>
    <AppStoreBadge app={app} />
    {app.hidden && (
      <p class="app-rail__status">{strings.appRail.inDevelopment}</p>
    )}
    <nav class="app-rail__sub" aria-label={strings.appRail.pagesFor}>
      {items.map((it) => (
        <a href={it.href} aria-current={it.id === current ? 'page' : undefined}>{it.label}</a>
      ))}
    </nav>
  </div>
</aside>

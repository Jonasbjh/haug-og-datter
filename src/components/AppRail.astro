---
/**
 * AppRail — smal sticky venstrespalte som vises på alle app-undersider.
 * Inneholder iPhone-mockup, app-tittel, italic tagline, meta-linje
 * (swatch + hex + indeks), CTA-pille og sub-nav (Oversikt/Personvern/
 * Vilkår/Support).
 *
 * Bredden er bevisst 168–176px — bare så vidt bredere enn telefonen.
 * Høyre spalte (.app-flow) er der det meste skjer.
 */
import type { AppDef } from '../data/apps';
import { apps, indexOf } from '../data/apps';
import { resolveLocale, t, localizedPath } from '../i18n/translations';
import Phone from './Phone.astro';

interface Props {
  app: AppDef;
  current: 'oversikt' | 'personvern' | 'vilkar' | 'support';
}
const { app, current } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const strings = t(locale);
const idx = indexOf(app.slug);
const num = String(idx + 1).padStart(2, '0');
const total = String(apps.length).padStart(2, '0');
const items = [
  { id: 'oversikt',   href: localizedPath(locale, `/${app.slug}`),             label: strings.appRail.oversikt },
  { id: 'personvern', href: localizedPath(locale, `/${app.slug}/personvern`),  label: strings.appRail.personvern },
  { id: 'vilkar',     href: localizedPath(locale, `/${app.slug}/vilkar`),      label: strings.appRail.vilkar },
  { id: 'support',    href: localizedPath(locale, `/${app.slug}/support`),     label: strings.appRail.support },
] as const;
---
<aside class="app-rail">
  <div class="app-rail__inner">
    <Phone app={app} />
    <h1 class="app-rail__name">{app.name}</h1>
    <p class="app-rail__tag">{app.tagline}</p>
    <div class="app-rail__meta">
      <span class="swatch" aria-hidden="true"></span>
      <span class="hex">{app.accent.toUpperCase()}</span>
      <span>· {num} / {total}</span>
    </div>
    <a class="app-rail__cta" href={app.appStoreUrl} target="_blank" rel="noopener" aria-label={strings.appRail.appStoreAria(app.name)}>
      <svg class="app-rail__cta-badge" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 144 44" role="img" aria-hidden="true">
        <rect width="144" height="44" rx="8" fill="currentColor"/>
        <g fill="#fff" transform="translate(12 9)">
          <path d="M11.4 2.95c.58-.7.97-1.67.86-2.65-.84.04-1.86.56-2.46 1.27-.54.62-1 1.61-.88 2.56.94.07 1.9-.48 2.48-1.18zm.85 1.36c-1.36-.08-2.52.77-3.17.77-.66 0-1.65-.73-2.73-.71-1.4.02-2.7.81-3.42 2.07-1.46 2.53-.37 6.27 1.04 8.32.69.99 1.51 2.11 2.59 2.07 1.04-.04 1.43-.67 2.69-.67s1.62.67 2.72.65c1.13-.02 1.83-1.01 2.52-2.01.79-1.15 1.12-2.27 1.13-2.32-.02-.01-2.17-.83-2.19-3.3-.02-2.06 1.69-3.05 1.76-3.1-.96-1.42-2.45-1.58-2.94-1.61z"/>
        </g>
        <text x="40" y="18" fill="#fff" font-family="-apple-system, Helvetica, Arial, sans-serif" font-size="8" letter-spacing="0.04em">{strings.appRail.appStoreCta}</text>
        <text x="40" y="33" fill="#fff" font-family="-apple-system, Helvetica, Arial, sans-serif" font-size="14" font-weight="600" letter-spacing="-0.02em">{strings.appRail.appStoreName}</text>
      </svg>
    </a>
    <nav class="app-rail__sub" aria-label={strings.appRail.pagesFor}>
      {items.map((it) => (
        <a href={it.href} aria-current={it.id === current ? 'page' : undefined}>{it.label}</a>
      ))}
    </nav>
  </div>
</aside>

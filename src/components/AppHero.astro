---
/**
 * AppHero — toppen av en app-side. Eyebrow med swatch + hex + nummer,
 * stor app-tittel, tagline, og en App-Store-badge som linker til appen.
 * Glyph-en (vannmerke-SVG) renderes som søsken så den får riktig
 * absolute-posisjonering bak hero-en.
 */
import type { AppDef } from '../data/apps';
import { indexOf } from '../data/apps';
import Glyph from './Glyph.astro';

interface Props { app: AppDef }
const { app } = Astro.props;
const idx = indexOf(app.slug);
const num = String(idx + 1).padStart(2, '0');
const hex = app.accent.toUpperCase();
---
<section class="app-hero reveal" aria-labelledby="app-title">
  <Glyph kind={app.glyph} />
  <div class="app-hero__l">
    <span class="num">
      <span class="swatch" aria-hidden="true"></span>
      <span class="hex">{hex}</span>
      <span>· {num} / 05</span>
    </span>
    <h1 id="app-title">{app.name}</h1>
    <p class="tag">{app.tagline}</p>
    <div class="app-cta">
      <a class="badge" href={app.appStoreUrl} target="_blank" rel="noopener" aria-label={`Last ned ${app.name} i App Store`}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 144 44" role="img" aria-hidden="true">
          <rect width="144" height="44" rx="8" fill="#000"/>
          <g fill="#fff" transform="translate(12 9)">
            <path d="M11.4 2.95c.58-.7.97-1.67.86-2.65-.84.04-1.86.56-2.46 1.27-.54.62-1 1.61-.88 2.56.94.07 1.9-.48 2.48-1.18zm.85 1.36c-1.36-.08-2.52.77-3.17.77-.66 0-1.65-.73-2.73-.71-1.4.02-2.7.81-3.42 2.07-1.46 2.53-.37 6.27 1.04 8.32.69.99 1.51 2.11 2.59 2.07 1.04-.04 1.43-.67 2.69-.67s1.62.67 2.72.65c1.13-.02 1.83-1.01 2.52-2.01.79-1.15 1.12-2.27 1.13-2.32-.02-.01-2.17-.83-2.19-3.3-.02-2.06 1.69-3.05 1.76-3.1-.96-1.42-2.45-1.58-2.94-1.61z"/>
          </g>
          <text x="40" y="18" fill="#fff" font-family="-apple-system, Helvetica, Arial, sans-serif" font-size="8" letter-spacing="0.04em">LAST NED I</text>
          <text x="40" y="33" fill="#fff" font-family="-apple-system, Helvetica, Arial, sans-serif" font-size="14" font-weight="600" letter-spacing="-0.02em">App Store</text>
        </svg>
      </a>
    </div>
  </div>
  <div class="app-hero__r">
    <div class="app-hero__icon">
      <img src={app.iconPath} alt={`${app.name} ikon`} width="132" height="132" loading="eager" />
    </div>
  </div>
</section>

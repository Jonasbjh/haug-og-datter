---
/**
 * Topbar — vises på alle sider.
 * Hub-varianten viser GPS-koordinater + live klokke.
 * App-varianten viser «Tilbake»-lenker.
 */
interface Props {
  variant?: 'hub' | 'app';
}
const { variant = 'hub' } = Astro.props;
---
<header class="topbar">
  <a class="mark" href="/">
    <span class="nm">Haug og Datter</span>
  </a>
  {variant === 'hub' ? (
    <span class="meter">
      <span class="seg">
        <span class="dot"></span>
        59°44′ N · 10°12′ E
      </span>
      <span class="seg">
        <span class="clock mono" data-clock>——:——:——</span>
      </span>
    </span>
  ) : (
    <nav class="nav" aria-label="Topbar">
      <a href="/">Tilbake</a>
      <a href="mailto:jonas@haugogdatter.no">Kontakt</a>
    </nav>
  )}
</header>

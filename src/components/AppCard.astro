---
/**
 * AppCard — en rad i Verket-listen på hub-en. Hover/tap fyller raden
 * med appens accent (CSS-styrt). Klikk trigger accent-svep via
 * sweep-link-interceptor i scripts/main.ts.
 */
import type { AppDef } from '../data/apps';
import { getTagline } from '../data/apps';
import { resolveLocale, localizedPath } from '../i18n/translations';
interface Props {
  app: AppDef;
  index: number;
}
const { app, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const hex = app.accent.toUpperCase();
const locale = resolveLocale(Astro.currentLocale);
---
<a
  class="verket__row"
  href={localizedPath(locale, `/${app.slug}`)}
  style={`--row-accent:${app.accent};--i:${index}`}
>
  <span class="verket__num">{num}</span>
  <span>
    <span class="verket__name" style="display:block">{app.name}</span>
    <span class="verket__tag" style="display:block">{getTagline(app, locale)}</span>
  </span>
  <span class="verket__meta">
    <span class="swatch" aria-hidden="true"></span>
    <span class="hex">{hex}</span>
  </span>
  <span class="verket__arrow" aria-hidden="true">→</span>
</a>

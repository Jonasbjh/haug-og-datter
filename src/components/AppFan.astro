---
/**
 * AppFan — «Atelieret»-vifta som erstatter den vertikale app-lista
 * midt på hub-en. Seks iPhone-mockups fanned ut med roterte
 * transformasjoner; hover løfter den aktive opp og demper de andre.
 *
 * Sweep-animasjonen ved klikk håndteres av main.ts via
 * `.atelier__phone` i sweep-link-interceptoren.
 */
import { visibleApps, getTagline } from '../data/apps';
import { resolveLocale, t, localizedPath } from '../i18n/translations';

const locale = resolveLocale(Astro.currentLocale);
const strings = t(locale);

/** Fargesymmetrisk visningsrekkefølge for vifta (8 apper): Tenkt
 *  (gyllen) og Stoneward (skiferblå) ytterst, og grønt/rust i jevn
 *  veksling mellom dem — grønn, rust, grønn || rust, grønn, rust.
 *  Gjelder KUN vifta — meny, tastatur og ⌘K følger apps.ts-rekkefølgen.
 *  NB: nye apper må plasseres manuelt her for å bevare symmetrien
 *  (ukjente slugs havner bakerst). */
const FAN_ORDER = [
  'tenkt',
  'naboskap',
  'bumle-bjorn',
  'plantekn',
  'hyttepermen',
  'inklings-journal',
  'kvitteringsvakt',
  'stoneward',
];
const fanApps = [
  ...FAN_ORDER.flatMap((slug) => visibleApps.filter((a) => a.slug === slug)),
  ...visibleApps.filter((a) => !FAN_ORDER.includes(a.slug)),
];
---
<section id="atelieret" class="atelier reveal" aria-label="Apper">
  <div
    class="atelier__stage"
    role="list"
    data-default-num="01"
    data-default-name={fanApps[0]?.name ?? ''}
  >
    {fanApps.map((app, i) => {
      const num = String(i + 1).padStart(2, '0');
      return (
        <a
          class="atelier__phone"
          href={localizedPath(locale, `/${app.slug}`)}
          role="listitem"
          data-idx={i}
          data-num={num}
          data-name={app.name}
          style={`--accent: ${app.accent}; --idx: ${i};`}
          aria-label={strings.atelier.goTo(app.name)}
        >
          <span class="atelier__notch" aria-hidden="true"></span>
          <div class="atelier__screen">
            <div class="atelier__icon">
              <img
                src={app.iconPath}
                alt=""
                width="72"
                height="72"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="atelier__name">{app.name}</div>
            <div class="atelier__body">
              <div class="atelier__grid" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
              </div>
              <p class="atelier__tag">{getTagline(app, locale)}</p>
            </div>
            <div class="atelier__dock" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <div class="atelier__caption" aria-live="polite">
    <span class="atelier__counter">{`01 / ${String(fanApps.length).padStart(2, '0')}`}</span>
    <span class="atelier__label">{fanApps[0]?.name ?? ''}</span>
  </div>

  <!-- Skodda over viftekronene på forsiden. Kun stilet når AppFan står
       rett etter NaturHero (.naturhero + .atelier .vifte-taake), ellers
       er den en tom, usynlig div. Musa tynner tåka, scroll løser den opp. -->
  <div class="vifte-taake" aria-hidden="true">
    <div class="vifte-taake__dott vifte-taake__dott--1"></div>
    <div class="vifte-taake__dott vifte-taake__dott--2"></div>
    <div class="vifte-taake__dott vifte-taake__dott--3"></div>
    <div class="vifte-taake__dott vifte-taake__dott--4"></div>
    <div class="vifte-taake__dott vifte-taake__dott--5"></div>
  </div>
</section>

<script>
  // Oppdater caption (counter + navn) basert på hvilken telefon som er
  // hovret/fokusert. Faller tilbake til app-1 når man forlater.
  const stage = document.querySelector<HTMLElement>('.atelier__stage');
  const counter = document.querySelector<HTMLElement>('.atelier__counter');
  const label = document.querySelector<HTMLElement>('.atelier__label');

  if (stage && counter && label) {
    const total = stage.querySelectorAll('.atelier__phone').length;
    const totalStr = String(total).padStart(2, '0');
    const defaultNum = stage.dataset.defaultNum ?? '01';
    const defaultName = stage.dataset.defaultName ?? '';

    const setActive = (num: string, name: string) => {
      counter.textContent = `${num} / ${totalStr}`;
      label.textContent = name;
    };
    const reset = () => setActive(defaultNum, defaultName);

    stage.querySelectorAll<HTMLAnchorElement>('.atelier__phone').forEach((p) => {
      const onIn = () => setActive(p.dataset.num ?? '', p.dataset.name ?? '');
      p.addEventListener('mouseenter', onIn);
      p.addEventListener('focusin', onIn);
      p.addEventListener('mouseleave', reset);
      p.addEventListener('focusout', reset);
    });
  }

  // Skodda: musa brenner et mykt hull i tåka (mask-posisjon følger
  // pekeren), og scroll løser opp hele laget — engangs per sidelasting.
  // Berøringsskjermer har ingen peker, der gjør scrollen hele jobben.
  const taake = document.querySelector<HTMLElement>('.vifte-taake');
  if (taake) {
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let raf = 0;
      let mx = 0;
      let my = 0;
      document.addEventListener(
        'mousemove',
        (e) => {
          mx = e.clientX;
          my = e.clientY;
          if (!raf) {
            raf = requestAnimationFrame(() => {
              raf = 0;
              const r = taake.getBoundingClientRect();
              taake.style.setProperty('--fx', `${mx - r.left}px`);
              taake.style.setProperty('--fy', `${my - r.top}px`);
            });
          }
        },
        { passive: true }
      );
    }

    const onScroll = () => {
      const p = Math.min(1, window.scrollY / (window.innerHeight * 0.55));
      taake.style.opacity = String(1 - p);
      if (p >= 1) {
        taake.classList.add('er-borte');
        window.removeEventListener('scroll', onScroll);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

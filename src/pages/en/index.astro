---
import HubLayout from '../../layouts/HubLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppFan from '../../components/AppFan.astro';
---
<HubLayout>
  <Topbar variant="hub" />

  <section class="hero reveal">
    <h1 class="display" data-parallax-title>
      <span class="word">{[...'Haug'].map((ch) => <span class="ltr">{ch}</span>)}</span>
      {' '}
      <span class="amp">&amp;</span>
      {' '}
      <span class="word">{[...'Datter'].map((ch) => <span class="ltr">{ch}</span>)}</span>
    </h1>
    <p class="lede">A small app studio. Apps built with time, patience, and a little too much coffee.</p>
    <img class="hero__logo" src="/logo/haug-datter-skogen.svg" alt="Haug & Datter — Drammen, Norway" width="300" height="300" />
  </section>

  <AppFan />

  <section class="blocks reveal">
    <div class="block">
      <h2>About</h2>
      <p>Haug & Datter is run by Jonas from Drammen, Norway. In the evenings he builds apps and things he likes. His daughter is two and a half and, like kids that age, has strong opinions about absolutely everything. She tests the kids' apps before they ship, and «one more time, dad!» is the best feedback we can get.</p>
    </div>
    <div class="block">
      <h2>Contact</h2>
      <p>
        <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>
      </p>
    </div>
  </section>

  <Footer label="Haug & Datter · Drammen" />
</HubLayout>

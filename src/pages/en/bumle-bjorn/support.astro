---
import AppLayout from '../../../layouts/AppLayout.astro';
import Topbar from '../../../components/Topbar.astro';
import Footer from '../../../components/Footer.astro';
import AppRail from '../../../components/AppRail.astro';
import Chapter from '../../../components/Chapter.astro';
import { getApp } from '../../../data/apps';
const app = getApp('bumle-bjorn');
---
<AppLayout app={app} title={`Support · ${app.name}`}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="support" />
    <div class="app-flow">
      <Chapter num="01" label="Contact" title={`Send <em>email</em>.`}>
        <p class="lede">Need help with {app.name}? Send an email to <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>. You'll get a reply from Jonas himself, usually within a day.</p>
      </Chapter>
      <Chapter num="02" label="FAQ" title={`What people <em>ask about</em>.`}>
        <p><strong>How do I record a new word?</strong></p>
        <p class="muted">Open parent mode (long-press the gear icon and hold for two seconds), choose "Add word", take a picture of the thing, and record the sound of you saying the word.</p>
        <p><strong>Do recordings sync between iPad and iPhone?</strong></p>
        <p class="muted">Yes, if you have iCloud Drive enabled in iOS settings. Otherwise the recordings stay only on the device where you recorded them.</p>
        <p><strong>Did I lose my recordings when I switched phones?</strong></p>
        <p class="muted">If you had iCloud sync enabled when recording, you'll find them again by signing in to the same Apple ID on the new phone and opening the app. If not, they're gone.</p>
      </Chapter>
      <Chapter num="03" label="Feedback" title={`Ideas, <em>bugs</em>, tips.`}>
        <p>Features you miss? Bugs that annoy? Send them to the same address. I read everything and prioritize based on what actually makes the app better.</p>
      </Chapter>
    </div>
  </div>
  <Footer label={`${app.name} · Support`} />
</AppLayout>

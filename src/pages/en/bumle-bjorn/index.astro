---
import AppLayout from '../../../layouts/AppLayout.astro';
import Topbar from '../../../components/Topbar.astro';
import Footer from '../../../components/Footer.astro';
import AppRail from '../../../components/AppRail.astro';
import Chapter from '../../../components/Chapter.astro';
import ChapterShots from '../../../components/ChapterShots.astro';
import PrevNextApp from '../../../components/PrevNextApp.astro';
import { getApp } from '../../../data/apps';
const app = getApp('bumle-bjorn');
---
<AppLayout app={app}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="oversikt" />
    <div class="app-flow">
      <Chapter num="01" label="Why" title={`A little piece of <em>everyday magic</em>.`}>
        <p class="lede">Bumle Bjørn exists because my daughter deserved better apps than the ones I saw on the App Store.</p>
        <p class="muted">Parents' own voices, not a synthetic American narrator. No ads. Perfectly fine to stop after five minutes.</p>
      </Chapter>
      <Chapter num="02" label="How it feels" title={`Built for <em>those small moments</em>.`}>
        <p>On the bus, before bedtime, while dinner simmers. You hand the phone to your child knowing that what shows up is safe and made for exactly this moment.</p>
        <ChapterShots shots={[
          { src: '/screenshots/bumle-bjorn/01-home.png', alt: 'Home screen' },
          { src: '/screenshots/bumle-bjorn/02-game.png', alt: 'Game mode' },
          { src: '/screenshots/bumle-bjorn/03-voices.png', alt: 'Voice recordings' },
          { src: '/screenshots/bumle-bjorn/04-result.png', alt: 'Result' },
          { src: '/screenshots/bumle-bjorn/05-bear.png', alt: 'Bumle' },
        ]} />
      </Chapter>
      <Chapter num="03" label="What it does" title={`Three things it does <em>well</em>.`}>
        <p>Your own voices. Parents, grandparents, or teachers record the words themselves. The child hears familiar voices and dialects, not a synthetic narrator.</p>
        <p>Image and sound recognition. The child drags, points, or picks. No points or stars that distract from the sense of mastery.</p>
        <p>Parent mode with a code. Settings and recordings locked behind a simple gate so children can't accidentally delete content.</p>
      </Chapter>
      <PrevNextApp slug={app.slug} />
    </div>
  </div>
  <Footer label={`${app.name} · Haug & Datter`} />
</AppLayout>

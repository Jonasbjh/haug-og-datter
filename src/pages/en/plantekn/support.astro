---
import AppLayout from '../../../layouts/AppLayout.astro';
import Topbar from '../../../components/Topbar.astro';
import Footer from '../../../components/Footer.astro';
import AppRail from '../../../components/AppRail.astro';
import Chapter from '../../../components/Chapter.astro';
import { getApp } from '../../../data/apps';
const app = getApp('plantekn');
---
<AppLayout app={app} title={`Support · ${app.name}`}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="support" />
    <div class="app-flow">
      <Chapter num="01" label="Contact" title={`Send <em>email</em>.`}>
        <p class="lede">Need help with {app.name}? Send an email to <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>. You'll get a reply from Jonas himself, usually within a day.</p>
      </Chapter>
      <Chapter num="02" label="FAQ" title={`What people <em>ask about</em>.`}>
        <p><strong>Can I export the drawing as a PDF?</strong></p>
        <p class="muted">Yes. Tap the share icon in the upper-right corner of the drawing sheet and pick PDF or image. The file is saved to the Files app — from there you can send it anywhere.</p>
        <p><strong>Why aren't my drawings syncing between iPad and iPhone?</strong></p>
        <p class="muted">Check that iCloud Drive is enabled in iOS settings on both devices, and that both are signed in to the same Apple ID.</p>
        <p><strong>Can I add custom furniture dimensions?</strong></p>
        <p class="muted">Yes. Create a new rectangle with exact measurements, double-tap, and save as "Custom furniture." It appears in your library for future drawings.</p>
      </Chapter>
      <Chapter num="03" label="Feedback" title={`Ideas, <em>bugs</em>, tips.`}>
        <p>Features you miss? Bugs that annoy? Send them to the same address. I read everything and prioritize based on what actually makes the app better.</p>
      </Chapter>
    </div>
  </div>
  <Footer label={`${app.name} · Support`} />
</AppLayout>

---
import AppLayout from '../../../layouts/AppLayout.astro';
import Topbar from '../../../components/Topbar.astro';
import Footer from '../../../components/Footer.astro';
import AppRail from '../../../components/AppRail.astro';
import Chapter from '../../../components/Chapter.astro';
import { getApp } from '../../../data/apps';
const app = getApp('plantekn');
---
<AppLayout app={app} title={`Privacy · ${app.name}`}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="personvern" />
    <div class="app-flow">
      <Chapter num="01" label="Overview" title={`Privacy, in <em>plain English</em>.`}>
        <p class="lede">{app.name} is built by Haug & Datter (Jonas Haug, Drammen, Norway). We take privacy seriously. This policy explains how the app handles your data.</p>
        <p class="muted">Last updated · March 2026.</p>
      </Chapter>

      <Chapter num="02" label="Data" title={`What we <em>don't</em> collect.`}>
        <p>{app.name} collects no personal data. The app:</p>
        <p>· Requires no registration or login.</p>
        <p>· Sends no data to external servers.</p>
        <p>· Uses no analytics or tracking tools.</p>
        <p>· Contains no advertising.</p>
      </Chapter>

      <Chapter num="03" label="Local storage" title={`The drawings are <em>yours</em>.`}>
        <p>All drawings and settings are stored locally on your device. No data is transferred to the cloud or to third parties.</p>
        <p class="muted">If you have iCloud sync enabled in iOS settings, content syncs between your own devices via Apple's encrypted iCloud. We have no access to it.</p>
      </Chapter>

      <Chapter num="04" label="Purchases" title={`PRO is handled by <em>Apple</em>.`}>
        <p>{app.name} offers an optional PRO upgrade via the App Store. All purchase transactions are handled by Apple. We have no access to your payment information.</p>
      </Chapter>

      <Chapter num="05" label="Third parties" title={`No tracking. <em>No analytics.</em>`}>
        <p>The app shares no data with third parties. The only external service used is Apple's StoreKit for in-app purchases.</p>
      </Chapter>

      <Chapter num="06" label="Children" title={`No data from <em>any</em> user.`}>
        <p>The app collects no data from any user, including children. There is no age restriction for using the app.</p>
      </Chapter>

      <Chapter num="07" label="Contact" title={`Questions? <em>Write to us.</em>`}>
        <p>Send email to <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>. You'll get a reply from Jonas himself, usually within a day.</p>
        <p class="muted">We may update this policy as needed. Any changes will be published on this page with an updated date.</p>
      </Chapter>
    </div>
  </div>
  <Footer label={`${app.name} · Privacy`} />
</AppLayout>

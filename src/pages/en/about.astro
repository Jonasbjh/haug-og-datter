---
import HubLayout from '../../layouts/HubLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import { visibleApps } from '../../data/apps';
---
<HubLayout
  title="About · Haug & Datter"
  description="About Jonas, Haug & Datter, and why I build apps in the evenings from Drammen, Norway."
>
  <Topbar variant="hub" />

  <section class="hero reveal">
    <h1 class="display">About</h1>
    <p class="lede">A small app studio run by one dad from Drammen, Norway.</p>
    <img class="hero__logo" src="/logo/haug-datter-skogen-en.svg" alt="Haug & Datter" width="300" height="300" />
  </section>

  <section class="blocks reveal">
    <div class="block">
      <h2>About</h2>
      <p>Haug & Datter is me, Jonas. In the evenings, once the house has gone quiet, I build apps I want to use myself. My daughter tests the kids' apps before they ship, and "one more time, dad!" is the best feedback I can get.</p>
    </div>

    <div class="block">
      <h2>The work</h2>
      <p class="verkliste-intro">{visibleApps.length} apps so far, in the order they were made.</p>
      <ol class="verkliste">
        {visibleApps.map((app, i) => (
          <li style={`--accent:${app.accent}`}>
            <span class="verkliste__num">{String(i + 1).padStart(2, '0')}</span>
            <a class="verkliste__navn" href={`/en/${app.slug}/`}>{app.name}</a>
            <span class="verkliste__tag">{app.tagline.en}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="block">
      <h2>Contact</h2>
      <p>
        <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>
      </p>
    </div>
  </section>

  <Footer label="Haug & Datter · Drammen" />
</HubLayout>

<style>
  .verkliste-intro {
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .verkliste {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    width: 100%;
    max-width: 52ch;
    text-align: left;
  }
  .verkliste li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .verkliste li:last-child { border-bottom: none; }
  .verkliste__num {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
    flex: none;
  }
  .verkliste__navn {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 19px;
    color: var(--ink);
    text-decoration: none;
    flex: none;
  }
  .verkliste__navn:hover { color: var(--accent); }
  .verkliste__tag {
    font-size: 13px;
    color: var(--ink-mute);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .verkliste__tag { display: none; }
  }
</style>

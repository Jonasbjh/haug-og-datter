---
import AppLayout from '../../../layouts/AppLayout.astro';
import Topbar from '../../../components/Topbar.astro';
import Footer from '../../../components/Footer.astro';
import AppRail from '../../../components/AppRail.astro';
import Chapter from '../../../components/Chapter.astro';
import { getApp } from '../../../data/apps';
const app = getApp('inklings-journal');
---
<AppLayout app={app} title={`Support · ${app.name}`}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="support" />
    <div class="app-flow">
      <Chapter num="01" label="Contact" title={`Send <em>email</em>.`}>
        <p class="lede">Need help with {app.name}? Send an email to <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>. You'll get a reply from Jonas himself, usually within a day.</p>
      </Chapter>
      <Chapter num="02" label="FAQ" title={`What people <em>ask about</em>.`}>
        <p><strong>How do I enable Face ID lock?</strong></p>
        <p class="muted">Settings → Security → "Require Face ID to open." You'll need to authenticate every time you open the app.</p>
        <p><strong>How do I export my journal?</strong></p>
        <p class="muted">Settings → Export → choose period (all, month, year) → markdown or PDF. The file is saved to the Files app.</p>
        <p><strong>Does content sync between iPad and iPhone?</strong></p>
        <p class="muted">Only if you've enabled it. Settings → Sync → "Sync via iCloud." It's off by default.</p>
      </Chapter>
      <Chapter num="03" label="Feedback" title={`Ideas, <em>bugs</em>, tips.`}>
        <p>Features you miss? Bugs that annoy? Send them to the same address. I read everything and prioritize based on what actually makes the app better.</p>
      </Chapter>
    </div>
  </div>
  <Footer label={`${app.name} · Support`} />
</AppLayout>

---
import HubLayout from '../layouts/HubLayout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import AppFan from '../components/AppFan.astro';
---
<HubLayout>
  <Topbar variant="hub" />

  <section class="hero reveal">
    <h1 class="display" data-parallax-title>
      <span class="word">{[...'Haug'].map((ch) => <span class="ltr">{ch}</span>)}</span>
      {' '}
      <span class="amp">&amp;</span>
      {' '}
      <span class="word">{[...'Datter'].map((ch) => <span class="ltr">{ch}</span>)}</span>
    </h1>
    <p class="lede">Et lite app-makeri. Apper laget med tid, tålmodighet og litt for mye kaffe.</p>
    <img class="hero__logo" src="/logo/haug-datter-skogen.svg" alt="Haug & Datter — Drammen, Norge" width="300" height="300" />
  </section>

  <AppFan />

  <section class="blocks reveal">
    <div class="block">
      <h2>Om</h2>
      <p>Haug & Datter drives av Jonas fra Drammen. På kveldstid lager han apper og ting han liker. Datteren er to og et halvt og har, som barn i den alderen, sterke meninger om absolutt alt. Hun tester barneappene før de slippes, og «en gang til, pappa!» er den beste tilbakemeldingen vi kan få.</p>
    </div>
    <div class="block">
      <h2>Kontakt</h2>
      <p>
        <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>
      </p>
    </div>
  </section>

  <Footer label="Haug & Datter · Drammen" />
</HubLayout>

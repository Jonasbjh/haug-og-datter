---
import HubLayout from '../layouts/HubLayout.astro';
import Footer from '../components/Footer.astro';
import AppFan from '../components/AppFan.astro';
---
<HubLayout>
  <section class="hero hero--home reveal">
    <h1 class="display" data-parallax-title>
      <span class="word">{[...'Haug'].map((ch) => <span class="ltr">{ch}</span>)}</span>
      {' '}
      <span class="amp">&amp;</span>
      {' '}
      <span class="word">{[...'Datter'].map((ch) => <span class="ltr">{ch}</span>)}</span>
    </h1>
    <p class="lede">Et lite app-makeri. Apper laget med tid, tålmodighet og litt for mye kaffe.</p>
    <img class="hero__logo" src="/logo/haug-datter-skogen.svg?v=2" alt="Haug & Datter — Drammen, Norge" width="300" height="300" />
  </section>

  <AppFan />

  <Footer label="Haug & Datter · Drammen" />
</HubLayout>

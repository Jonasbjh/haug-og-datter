---
import AppLayout from '../../layouts/AppLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppRail from '../../components/AppRail.astro';
import Chapter from '../../components/Chapter.astro';
import ChapterShots from '../../components/ChapterShots.astro';
import PrevNextApp from '../../components/PrevNextApp.astro';
import { getApp } from '../../data/apps';
const app = getApp('inklings-journal');
---
<AppLayout app={app}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="oversikt" />
    <div class="app-flow">
      <Chapter num="01" label="Hvorfor" title={`Et stille rom for <em>dagens tanke</em>.`}>
        <p class="lede">Inklings Journal er bygget rundt én idé: en dagbok skal være liten og rolig. Et stille rom for dagens tanke, ikke en tjeneste å holde liv i.</p>
        <p class="muted">Daglig prompt eller blank side. Lokalt først, iCloud kun hvis du selv velger det. Face ID hvis du vil. Markdown-eksport når du vil ta innholdet med deg.</p>
      </Chapter>
      <Chapter num="02" label="Slik føles det" title={`Skriv først. <em>Resten</em> kan vente.`}>
        <p>Du har ti minutter mellom møtene. Du åpner Inklings, ser dagens prompt («Hva la jeg merke til?»), skriver to setninger. Du lukker igjen. Det føltes ikke som arbeid.</p>
        <ChapterShots count={6} />
      </Chapter>
      <Chapter num="03" label="Hva den gjør" title={`Daglig prompt. <em>Søk.</em> Eksport.`}>
        <p>Daglig prompt eller blank side, du velger selv. Inklings kan vise en setning som starter pennen, eller du kan slå det av og bare skrive.</p>
        <p>Tidsmaskin og søk. Bla til denne datoen i fjor. Søk på et ord eller et tema gjennom alle entries.</p>
        <p>Lokalt først. Alt lagres i SwiftData på enheten din. iCloud-sync er valgfri og opt-in.</p>
      </Chapter>
      <PrevNextApp slug={app.slug} />
    </div>
  </div>
  <Footer label={`${app.name} · Haug & Datter`} />
</AppLayout>

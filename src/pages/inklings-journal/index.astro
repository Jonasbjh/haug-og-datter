---
import AppLayout from '../../layouts/AppLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppRail from '../../components/AppRail.astro';
import Chapter from '../../components/Chapter.astro';
import ChapterShots from '../../components/ChapterShots.astro';
import PrevNextApp from '../../components/PrevNextApp.astro';
import { getApp } from '../../data/apps';
const app = getApp('inklings-journal');
---
<AppLayout app={app}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="oversikt" />
    <div class="app-flow">
      <Chapter num="01" label="Hvorfor" title={`Et stille rom for <em>dagens tanke</em>.`}>
        <p class="lede">Inklings er bygget rundt én idé. En dagbok skal være liten og rolig. Et stille rom for dagens tanke, ikke en tjeneste å holde liv i.</p>
        <p>Det er ingen rekord å holde, ingen streak å miste, ingen påminnelser som maser. Hopper du over fire dager, er Inklings akkurat like glad å se deg på den femte.</p>
        <p class="muted">Daglig prompt eller blank side. Lokalt først. iCloud kun hvis du selv velger det.</p>
      </Chapter>
      <Chapter num="02" label="Slik føles det" title={`Skriv først. <em>Resten</em> kan vente.`}>
        <p>Du har ti minutter mellom møtene. Du åpner Inklings, ser dagens prompt («Hva la jeg merke til?»), skriver to setninger. Du lukker igjen. Det føltes ikke som arbeid.</p>
        <p>Designet er rolig og varmt. Serif-skrift, gull-aksent, mørk bakgrunn. Det ligner mer på en notatbok enn en app. Ingen blinkende elementer.</p>
        <ChapterShots shots={[
          { src: '/screenshots/inklings-journal/01-skriv.png', alt: 'Dagens spørsmål og skriveflaten' },
          { src: '/screenshots/inklings-journal/02-kalender.png', alt: 'Kalender med stemninger og tidskapsler' },
          { src: '/screenshots/inklings-journal/03-innsikt.png', alt: 'Innsikt: stemning og temaer over tid' },
          { src: '/screenshots/inklings-journal/04-refleksjon.png', alt: 'Din historie, skrevet av appen' },
          { src: '/screenshots/inklings-journal/05-tidskapsel.png', alt: 'Skriv en tidskapsel til deg selv' },
        ]} />
        <p class="muted">Face ID hvis du vil. Markdown-eksport når du vil ta innholdet med deg.</p>
      </Chapter>
      <Chapter num="03" label="Hva den gjør" title={`Daglig prompt. <em>Søk.</em> Eksport.`}>
        <p><strong>Daglig prompt eller blank side.</strong> Inklings kan vise en setning som starter pennen, eller du kan slå det av og bare skrive.</p>
        <p><strong>Tidsmaskin og søk.</strong> Bla til denne datoen i fjor. Søk på et ord eller et tema gjennom alle entries. Tag-system for å finne tilbake.</p>
        <p><strong>Lokalt først.</strong> Alt lagres i SwiftData på enheten din. iCloud-sync er valgfri og opt-in. Eksporter til markdown når som helst.</p>
        <p><strong>App Intents og Siri Shortcuts.</strong> «Hei Siri, åpne dagens Inklings» fra håndleddet. Liten ting, men det er den slags den er bygd for.</p>
      </Chapter>
      <PrevNextApp slug={app.slug} />
    </div>
  </div>
  <Footer label={`${app.name} · Haug & Datter`} />
</AppLayout>

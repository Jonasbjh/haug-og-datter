---
import AppLayout from '../../layouts/AppLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppRail from '../../components/AppRail.astro';
import Chapter from '../../components/Chapter.astro';
import { getApp } from '../../data/apps';
const app = getApp('inklings-journal');
---
<AppLayout app={app} title={`Support · ${app.name}`}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="support" />
    <div class="app-flow">
      <Chapter num="01" label="Kontakt" title={`Send <em>e-post</em>.`}>
        <p class="lede">Trenger du hjelp med {app.name}? Send en e-post til <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>. Du får svar fra Jonas selv, vanligvis innen et døgn.</p>
      </Chapter>
      <Chapter num="02" label="Vanlige spørsmål" title={`Det folk <em>spør om</em>.`}>
        <p><strong>Hvordan skrur jeg på Face ID-låsen?</strong></p>
        <p class="muted">Innstillinger → Sikkerhet → «Krev Face ID for å åpne». Da må du autentisere hver gang du åpner appen.</p>
        <p><strong>Hvordan eksporterer jeg journalen min?</strong></p>
        <p class="muted">Innstillinger → Eksport → velg periode (alt, måned, år) → markdown eller PDF. Filen lagres i Files-appen.</p>
        <p><strong>Synkroniseres innholdet mellom iPad og iPhone?</strong></p>
        <p class="muted">Bare hvis du selv har slått det på. Innstillinger → Sync → «Synkroniser via iCloud». Som standard er det av.</p>
      </Chapter>
      <Chapter num="03" label="Tilbakemelding" title={`Idéer, <em>bugs</em>, tips.`}>
        <p>Funksjoner du savner? Bugs som irriterer? Send dem til samme adresse. Jeg leser alt og prioriterer ut fra hva som faktisk gjør appen bedre.</p>
      </Chapter>
    </div>
  </div>
  <Footer label={`${app.name} · Support`} />
</AppLayout>

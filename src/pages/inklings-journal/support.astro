---
import AppLayout from '../../layouts/AppLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppNav from '../../components/AppNav.astro';
import { getApp } from '../../data/apps';
const app = getApp('inklings-journal');
---
<AppLayout app={app} title={`Support — ${app.name}`}>
  <Topbar variant="app" />
  <article class="doc reveal">
    <h1>Support for {app.name}</h1>
    <p class="lede">Trenger du hjelp? Send en e-post til <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>. Du får svar fra Jonas selv, vanligvis innen et døgn.</p>

    <h2>Vanlige spørsmål</h2>
    <h3 style="font-family:'Newsreader',Georgia,serif;font-size:22px;font-weight:500;color:var(--ink);letter-spacing:-0.012em;margin-top:28px;margin-bottom:6px;">[SPØRSMÅL 1]</h3>
    <p>[SVAR]</p>
    <h3 style="font-family:'Newsreader',Georgia,serif;font-size:22px;font-weight:500;color:var(--ink);letter-spacing:-0.012em;margin-top:28px;margin-bottom:6px;">[SPØRSMÅL 2]</h3>
    <p>[SVAR]</p>

    <h2>Send tilbakemelding</h2>
    <p>Tips, ønsker eller bugs? Send dem til samme adresse. Vi leser alt.</p>
  </article>

  <AppNav slug={app.slug} current="support" />

  <Footer label={`${app.name} · Support`} />
</AppLayout>

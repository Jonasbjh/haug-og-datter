---
import AppLayout from '../../layouts/AppLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppRail from '../../components/AppRail.astro';
import Chapter from '../../components/Chapter.astro';
import ChapterShots from '../../components/ChapterShots.astro';
import PrevNextApp from '../../components/PrevNextApp.astro';
import { getApp } from '../../data/apps';
const app = getApp('hyttepermen');
---
<AppLayout app={app}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="oversikt" />
    <div class="app-flow">
      <Chapter num="01" label="Hvorfor" title={`Alt om hytta. Samlet i <em>én perm</em>.`}>
        <p class="lede">Hyttepermen er appen for familier som deler hytte. Turene, sjekklistene, handlelisten, minnene og all den praktiske informasjonen som før lå i en slitt ringperm i skuffen, bor nå på ett sted. Og alle på hytta ser det samme.</p>
        <p class="muted">For iPhone og iPad.</p>
      </Chapter>

      <Chapter num="02" label="Turer og lister" title={`Planlegg turer <em>sammen</em>.`}>
        <p><strong>Planlegg turer sammen.</strong> Opprett en tur, inviter de som skal være med, og se hvem som kommer. Alle svarer med ett trykk, og du ser hvem som ankommer når. Turer er private for de inviterte, mens kalenderen viser alle når hytta er opptatt. Da blir det ingen dobbeltbookinger i påsken.</p>
        <p><strong>Sjekklister som husker for deg.</strong> Ankomst og avreise har hver sin liste, og kritiske punkt som hovedkran og strøm er merket. Alle ser hva som er gjort og hvem som gjorde det. Appen minner deg på avreisesjekklisten før du drar hjem.</p>
        <p><strong>Handleliste for hele hytta.</strong> Skriv inn det som mangler, så ser alle det. Den som står på butikken haker av, og prisene kan noteres så oppgjøret blir enkelt.</p>
        <ChapterShots shots={[
          { src: '/screenshots/hyttepermen/01-hjem.png', alt: 'Hjem-skjerm med hytta, vær og hurtigtilgang' },
          { src: '/screenshots/hyttepermen/02-aktiv-tur.png', alt: 'Aktiv tur med dagvising, vær og deltaker-tidslinje' },
          { src: '/screenshots/hyttepermen/03-sjekkliste.png', alt: 'Ankomst-sjekkliste, fire av seks gjort' },
          { src: '/screenshots/hyttepermen/04-peisen.png', alt: 'Peisen: hyttas chat mellom turer' },
          { src: '/screenshots/hyttepermen/05-hytteboka.png', alt: 'Hytteboka med innlegg fra fjoråret' },
          { src: '/screenshots/hyttepermen/06-permen.png', alt: 'Permen: kontakter, utstyr og rutiner' },
        ]} />
      </Chapter>

      <Chapter num="03" label="Minner og praten" title={`<em>Hytteboka</em>, Permen og Peisen.`}>
        <p><strong>Hytteboka.</strong> Familiens digitale gjestebok. Skriv om helgen, legg ved bilder, og la resten av familien reagere. Minnene fra hytta fortjener bedre enn å bli glemt.</p>
        <p><strong>Permen.</strong> Wifi-passordet, dørkoden, bruksanvisningen til varmepumpa og nummeret til vaktmesteren. Alt det praktiske, alltid tilgjengelig, også med talenotater og PDF-vedlegg. Sensitive felt er skjult til du trykker på dem.</p>
        <p><strong>Peisen.</strong> Hyttas egen chat. Beskjeder om stengt vann, hvem som tar med ved, og bilder fra sist tur. Mellom turene samles praten her.</p>
      </Chapter>

      <Chapter num="04" label="For eieren" title={`Full <em>kontroll</em>, tre roller.`}>
        <p>Vedlikeholdslogg, måleravlesninger for strøm og vann, og full kontroll på hvem som har tilgang. Tre roller holder orden: hytteeier, familie og gjest ser hver sitt.</p>
      </Chapter>

      <Chapter num="05" label="Personvern" title={`Ditt privatliv er <em>ikke produktet</em>.`}>
        <p>Hyttepermen har ingen servere, ingen kontoer, ingen sporing og ingen reklame. Alt lagres på din enhet og synkroniseres gjennom din egen iCloud. Vi kan ikke lese dataene dine, og det skal vi heller aldri kunne. Du kan eksportere alt til fil eller slette alt, når som helst.</p>
        <p class="muted">Les <a class="tx-link" href="/hyttepermen/personvern/">personvernerklæringen</a> og <a class="tx-link" href="/hyttepermen/vilkar/">brukervilkårene</a>.</p>
      </Chapter>

      <Chapter num="06" label="Pris" title={`Gratis, med <em>Plus</em> til 69 kr.`}>
        <p>Hyttepermen er gratis, med alle kjernefunksjoner inkludert. Gratis-versjonen gir én egen hytte og inntil fem deltakere per tur. Å bli med i en annens hytte er alltid gratis, uansett.</p>
        <p><strong>Hyttepermen Plus</strong> er et engangskjøp til 69 kroner som gir ubegrenset antall egne hytter og ubegrenset antall deltakere per tur. Ett kjøp gjelder hele hytta. Ingen abonnement, ingen skjulte kostnader.</p>
        <p class="muted">Spørsmål, idéer eller noe som ikke virker? Send en e-post til <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>. Jeg leser alt.</p>
      </Chapter>

      <PrevNextApp slug={app.slug} />
    </div>
  </div>
  <Footer label={`${app.name} · Haug & Datter`} />
</AppLayout>

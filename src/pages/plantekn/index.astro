---
import AppLayout from '../../layouts/AppLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppRail from '../../components/AppRail.astro';
import Chapter from '../../components/Chapter.astro';
import ChapterShots from '../../components/ChapterShots.astro';
import PrevNextApp from '../../components/PrevNextApp.astro';
import { getApp } from '../../data/apps';
const app = getApp('plantekn');
---
<AppLayout app={app}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="oversikt" />
    <div class="app-flow">
      <Chapter num="01" label="Hvorfor" title={`Verktøyet du <em>skulle hatt</em> i byggemøtet.`}>
        <p class="lede">Plantekn finnes fordi de profesjonelle planleggings-appene er for tunge. Du må bruke en helg på å lære dem. Papir og blyant er for løse. Du tegner sofaen og oppdager at den er to centimeter for bred når den allerede er kjøpt.</p>
        <p>Mellom de to står Plantekn. Et stille verktøy som gir deg presise mål og et nordisk møbelbibliotek, uten lærekurve.</p>
        <p class="muted">Bygd fordi jeg selv pusset opp og savnet det.</p>
      </Chapter>
      <Chapter num="02" label="Slik føles det" title={`<em>iPad og blyant</em>, samlet i ett.`}>
        <p>Du står midt i rommet du skal pusse opp. iPad-en er på, du tegner inn vegger med fingertuppen, drar inn sofaen fra biblioteket, og ser om alt får plass før du ringer butikken.</p>
        <p>Når du vipper til 3D, blir skissen til et rom du nesten kan stå i. Ikke et arkitekttegnings-rom, men nok til at du ser om kjøkkenøya er for nær veggen, om soverommet tåler en queen size, om garderoben må ha skyvedører.</p>
        <ChapterShots shots={[
          { src: '/screenshots/plantekn/01-hero.png', alt: 'Hovedvisning' },
          { src: '/screenshots/plantekn/02-furniture.png', alt: 'Møbel-bibliotek' },
          { src: '/screenshots/plantekn/03-freeform.png', alt: 'Frihåndstegning' },
          { src: '/screenshots/plantekn/04-3d.png', alt: '3D-visning' },
          { src: '/screenshots/plantekn/05-pro.png', alt: 'PRO-funksjoner' },
          { src: '/screenshots/plantekn/06-settings.png', alt: 'Innstillinger' },
        ]} />
        <p class="muted">Apple Pencil hvis du har den. Finger funker også.</p>
      </Chapter>
      <Chapter num="03" label="Hva den gjør" title={`<em>Mål, møbler</em>, Photo Trace.`}>
        <p><strong>Romlayout med ekte mål.</strong> Tegn vegger. Hver linje viser meter og centimeter. Alt holder seg presist når du forstørrer eller flytter. Areal beregnes etter NS 3940 (BRA, P-rom, S-rom).</p>
        <p><strong>Møbelbibliotek i nordiske mål.</strong> Sofa, seng, bord, kjøkkenelementer. Dra inn, roter, sjekk om det passer. PRO låser opp hele biblioteket pluss AI-baserte forslag når du står fast.</p>
        <p><strong>Photo Trace (PRO).</strong> Legg et bilde av et eksisterende rom under og tegn over det. Slipper å gjette mål fra fotografi.</p>
      </Chapter>
      <PrevNextApp slug={app.slug} />
    </div>
  </div>
  <Footer label={`${app.name} · Haug & Datter`} />
</AppLayout>

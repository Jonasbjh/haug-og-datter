---
import AppLayout from '../../layouts/AppLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppRail from '../../components/AppRail.astro';
import Chapter from '../../components/Chapter.astro';
import ChapterShots from '../../components/ChapterShots.astro';
import PrevNextApp from '../../components/PrevNextApp.astro';
import { getApp } from '../../data/apps';
const app = getApp('plantekn');
---
<AppLayout app={app}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="oversikt" />
    <div class="app-flow">
      <Chapter num="01" label="Hvorfor" title={`Verktøyet du <em>skulle hatt</em> i byggemøtet.`}>
        <p class="lede">Plantekn finnes fordi de profesjonelle planleggings-appene er for tunge, og papir og blyant er for løse.</p>
        <p class="muted">Et stille verktøy som gir deg presise mål, et nordisk møbel-bibliotek og enkelt el-symbolspråk, uten lærekurve.</p>
      </Chapter>
      <Chapter num="02" label="Slik føles det" title={`<em>iPad og blyant</em>, samlet i ett.`}>
        <p>Du står midt i rommet du skal pusse opp. iPad-en er på, du tegner inn vegger med fingertuppen, drar inn sofaen fra biblioteket, og ser om alt får plass før du ringer butikken.</p>
        <ChapterShots shots={[
          { src: '/screenshots/plantekn/01-hero.png', alt: 'Hovedvisning' },
          { src: '/screenshots/plantekn/02-furniture.png', alt: 'Møbel-bibliotek' },
          { src: '/screenshots/plantekn/03-freeform.png', alt: 'Frihåndstegning' },
          { src: '/screenshots/plantekn/04-3d.png', alt: '3D-visning' },
          { src: '/screenshots/plantekn/05-pro.png', alt: 'PRO-funksjoner' },
          { src: '/screenshots/plantekn/06-settings.png', alt: 'Innstillinger' },
        ]} />
      </Chapter>
      <Chapter num="03" label="Hva den gjør" title={`<em>Mål, møbler</em>, ledninger.`}>
        <p>Romlayout med ekte mål. Tegn vegger, hver linje viser meter og centimeter. Alt holder seg presist når du forstørrer eller flytter.</p>
        <p>Møbel-bibliotek i nordiske mål. Sofa, seng, bord, kjøkkenelementer. Dra inn, roter, sjekk om det passer.</p>
        <p>Ledningsføring og uttak. Standardiserte symboler, godt nok til å snakke med en elektriker uten misforståelser.</p>
      </Chapter>
      <PrevNextApp slug={app.slug} />
    </div>
  </div>
  <Footer label={`${app.name} · Haug & Datter`} />
</AppLayout>

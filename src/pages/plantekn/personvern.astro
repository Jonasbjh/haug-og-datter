---
import AppLayout from '../../layouts/AppLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppRail from '../../components/AppRail.astro';
import Chapter from '../../components/Chapter.astro';
import { getApp } from '../../data/apps';
const app = getApp('plantekn');
---
<AppLayout app={app} title={`Personvern · ${app.name}`}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="personvern" />
    <div class="app-flow">
      <Chapter num="01" label="I korte trekk" title={`Personvern, på <em>vanlig norsk</em>.`}>
        <p class="lede">{app.name} er utviklet av Haug & Datter (Jonas Haug, Drammen). Vi tar personvern på alvor. Denne erklæringen forklarer hvordan appen behandler dataene dine.</p>
        <p class="muted">Sist oppdatert · mars 2026.</p>
      </Chapter>

      <Chapter num="02" label="Data" title={`Hva vi <em>ikke</em> samler inn.`}>
        <p>{app.name} samler ingen persondata. Appen:</p>
        <p>· Krever ingen registrering eller innlogging.</p>
        <p>· Sender ingen data til eksterne servere.</p>
        <p>· Bruker ingen analyseverktøy eller sporingsløsninger.</p>
        <p>· Har ingen annonser.</p>
      </Chapter>

      <Chapter num="03" label="Lokal lagring" title={`Plantegningene er <em>dine</em>.`}>
        <p>Alle plantegninger og innstillinger lagres lokalt på enheten din. Ingen data overføres til skyen eller til tredjeparter.</p>
        <p class="muted">Hvis du har slått på iCloud-sync i iOS-innstillingene, synkroniseres innholdet mellom dine egne enheter via Apples krypterte iCloud. Vi har ingen tilgang til dette.</p>
      </Chapter>

      <Chapter num="04" label="Kjøp" title={`PRO håndteres av <em>Apple</em>.`}>
        <p>{app.name} tilbyr en valgfri PRO-oppgradering via Apples App Store. Alle kjøpstransaksjoner håndteres av Apple. Vi har ikke tilgang til betalingsopplysningene dine.</p>
      </Chapter>

      <Chapter num="05" label="Tredjepart" title={`Ingen sporing. <em>Ingen analyse.</em>`}>
        <p>Appen deler ingen data med tredjeparter. Den eneste eksterne tjenesten som benyttes er Apples StoreKit for kjøp i appen.</p>
      </Chapter>

      <Chapter num="06" label="Barn" title={`Ingen data fra <em>noen</em> brukere.`}>
        <p>Appen samler ingen data fra noen brukere, inkludert barn. Det er ingen aldersgrense for bruk av appen.</p>
      </Chapter>

      <Chapter num="07" label="Kontakt" title={`Spørsmål? <em>Skriv til oss.</em>`}>
        <p>Send e-post til <a class="tx-link" href="mailto:jonas@haugogdatter.no">jonas@haugogdatter.no</a>. Du får svar fra Jonas selv, vanligvis innen et døgn.</p>
        <p class="muted">Vi kan oppdatere denne erklæringen ved behov. Eventuelle endringer publiseres på denne siden med oppdatert dato.</p>
      </Chapter>
    </div>
  </div>
  <Footer label={`${app.name} · Personvern`} />
</AppLayout>

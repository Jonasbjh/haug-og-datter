---
import HubLayout from '../layouts/HubLayout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
---
<HubLayout
  title="Fant ikke siden · Haug & Datter"
  description="Siden finnes ikke."
>
  <Topbar variant="hub" />

  <section class="hero reveal">
    <h1 class="display">404</h1>
    <p class="lede">Denne siden finnes ikke. Kanskje den har flyttet, kanskje den aldri fantes.</p>
    <p class="lede"><a class="tx-link" href="/">Tilbake til forsiden</a> · <a class="tx-link" href="/en/">English</a></p>
  </section>

  <Footer label="Haug & Datter · Drammen" />
</HubLayout>

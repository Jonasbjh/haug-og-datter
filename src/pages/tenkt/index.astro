---
import AppLayout from '../../layouts/AppLayout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import AppRail from '../../components/AppRail.astro';
import Chapter from '../../components/Chapter.astro';
import ChapterShots from '../../components/ChapterShots.astro';
import PrevNextApp from '../../components/PrevNextApp.astro';
import { getApp } from '../../data/apps';
const app = getApp('tenkt');
---
<AppLayout app={app}>
  <Topbar variant="app" />
  <div class="app-page">
    <AppRail app={app} current="oversikt" />
    <div class="app-flow">
      <Chapter num="01" label="Hvorfor" title={`Stille logikk, <em>hver morgen</em>.`}>
        <p class="lede">Tenkt finnes fordi en pause med ren logikk fortjener å være ren. Ingen reklame, ingen profil, ingen fjas. Fem til ti korte oppgaver hver dag, samme for alle, fornyes ved midnatt.</p>
        <p class="muted">Norsk er et godt språk å tenke logisk i. Tenkt er på norsk fra første sekund.</p>
      </Chapter>
      <Chapter num="02" label="Slik føles det" title={`Fem minutter med <em>kaffe og tanke</em>.`}>
        <p>Du setter deg ned. Tar den første slurken. Åpner Tenkt. Et lite puslespill, kanskje to. Du føler deg våken, ferdig, og dagen kan begynne uten å ha åpnet et eneste varsel.</p>
        <ChapterShots shots={[
          { src: '/screenshots/tenkt/01-home.png', alt: 'Hjem-skjerm' },
          { src: '/screenshots/tenkt/02-puzzle-active.png', alt: 'Aktivt puslespill' },
          { src: '/screenshots/tenkt/03-puzzle-flow.png', alt: 'Stifinner-puslespill' },
          { src: '/screenshots/tenkt/04-summary.png', alt: 'Oppsummering' },
          { src: '/screenshots/tenkt/05-settings.png', alt: 'Innstillinger' },
        ]} />
      </Chapter>
      <Chapter num="03" label="Hva den gjør" title={`Et nytt sett <em>hver dag</em>.`}>
        <p>Daglig sett, generert lokalt. Alle som åpner Tenkt en gitt dag får eksakt det samme settet. Tre vanskelighetsgrader bygger seg opp gjennom dagens oppgaver.</p>
        <p>Fem ulike puslespilltyper. Rutenett, Stifinner, Plassering, Balanse og Kobling. Hver har egen mekanikk, alle løses med ren logikk uten gjetting.</p>
        <p>Streaks og statistikk, lokalt. Antall dager på rad, tider, stjerner. Alt på enheten din. Ingen leaderboard, ingen profil.</p>
      </Chapter>
      <PrevNextApp slug={app.slug} />
    </div>
  </div>
  <Footer label={`${app.name} · Haug & Datter`} />
</AppLayout>

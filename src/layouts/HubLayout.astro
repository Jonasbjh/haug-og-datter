---
/**
 * HubLayout — kun for forsiden (`/`). Setter accent til forest (default),
 * inkluderer chrome (sweep, spotlight, progress, kbd-hint), laster
 * Google Fonts og kjører klient-script. Spotlight aktiveres via
 * `data-spotlight` på theme-root så scriptet vet vi er på hub-en.
 */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Haug og Datter',
  description = 'Et lite app-makeri fra Drammen. Apper laget med tid, tålmodighet og litt for mye kaffe.',
} = Astro.props;
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Inter:wght@400;450;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="sweep" aria-hidden="true"></div>
    <div class="spotlight" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>

    <div class="theme-root" data-spotlight>
      <div class="stage">
        <slot />
      </div>
    </div>

    <div class="kbd-hint" aria-hidden="true">
      Trykk <kbd>1</kbd>–<kbd>5</kbd> for app · <kbd>⌘K</kbd> søk · <kbd>Esc</kbd> hjem
    </div>

    <script>
      import('../scripts/main.ts');
    </script>
  </body>
</html>

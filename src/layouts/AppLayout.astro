---
/**
 * AppLayout — for alle app-sider (oversikt, personvern, vilkår,
 * support). Setter `data-app={slug}` på theme-root så CSS-en kan
 * skille på app via attributt-selektorer, og setter `--accent` som
 * inline-stil så glyph + swatcher får riktig farge.
 */
import '../styles/global.css';
import type { AppDef } from '../data/apps';
import { getTagline } from '../data/apps';
import AppMenu from '../components/AppMenu.astro';
import { resolveLocale, t } from '../i18n/translations';

interface Props {
  app: AppDef;
  title?: string;
  description?: string;
}
const { app, title, description } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const strings = t(locale);
const pageTitle = title ?? `${app.name} · Haug & Datter`;
const pageDesc = description ?? getTagline(app, locale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://haugogdatter.no').toString();
const ogImage = new URL('/logo/haug-datter-skogen-og.png', Astro.site ?? 'https://haugogdatter.no').toString();
---
<!doctype html>
<html lang={strings.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content={app.accent} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Inter:wght@400;450;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Haug & Datter" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'nb_NO'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${app.name} — Haug & Datter`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="sweep" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>

    <AppMenu />

    <div class="theme-root" data-app={app.slug} style={`--accent:${app.accent}`}>
      <div class="app-backdrop" aria-hidden="true"></div>
      <div class="stage">
        <slot />
      </div>
    </div>

    <div class="kbd-hint" aria-hidden="true">
      {strings.kbdHint.press} <kbd>1</kbd>–<kbd>8</kbd> {strings.kbdHint.forApp} · <kbd>⌘K</kbd> {strings.kbdHint.search} · <kbd>Esc</kbd> {strings.kbdHint.home}
    </div>

    <script>
      import('../scripts/main.ts');
    </script>
  </body>
</html>

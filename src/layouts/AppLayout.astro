---
/**
 * AppLayout — for alle app-sider (oversikt, personvern, vilkår,
 * support). Setter `data-app={slug}` på theme-root så CSS-en kan
 * skille på app via attributt-selektorer, og setter `--accent` som
 * inline-stil så glyph + swatcher får riktig farge.
 */
import '../styles/global.css';
import type { AppDef } from '../data/apps';
import { getTagline, appStoreId } from '../data/apps';
import AppMenu from '../components/AppMenu.astro';
import { resolveLocale, t, localesForPath, switchLocalePath } from '../i18n/translations';

interface Props {
  app: AppDef;
  title?: string;
  description?: string;
}
const { app, title, description } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const strings = t(locale);
const pageTitle = title ?? `${app.name} · Haug & Datter`;
const pageDesc = description ?? getTagline(app, locale);
const site = Astro.site ?? 'https://haugogdatter.no';
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
/* Per-app OG-kort i appens aksentfarge. Genereres av
   scripts/lag-og-kort.mjs — kjør det på nytt hvis ikon/tagline endres. */
const ogImage = new URL(`/og/${app.slug}.png?v=2`, site).toString();
const altLocales = localesForPath(Astro.url.pathname);
const storeId = appStoreId(app);

/* JSON-LD: SoftwareApplication. Bevisst uten priser (de endres i App
   Store uten at nettsiden vet det). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: getTagline(app, locale),
  operatingSystem: 'iOS',
  applicationCategory: app.schemaCategory,
  url: canonicalUrl,
  image: new URL(app.iconPath, site).toString(),
  ...(storeId ? { installUrl: app.appStoreUrl, sameAs: app.appStoreUrl } : {}),
  author: {
    '@type': 'Organization',
    name: 'Haug & Datter',
    url: site.toString(),
  },
};
---
<!doctype html>
<html lang={strings.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content={app.accent} />
    <link rel="canonical" href={canonicalUrl} />
    {/* Språkalternativer for denne siden. Sitemapen har de samme, men
        crawlere som leser siden direkte finner dem her. */}
    {altLocales.map((l) => (
      <link
        rel="alternate"
        hreflang={l === 'no' ? 'nb-NO' : l}
        href={new URL(switchLocalePath(Astro.url.pathname, l), Astro.site ?? 'https://haugogdatter.no').toString()}
      />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Selvhostede fonter (src/styles/fonts.css via global.css). Preload av
        de to latin-filene som tegner nesten all tekst over folden. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/newsreader-normal-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-normal-latin.woff2" crossorigin />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Haug & Datter" />
    <meta property="og:locale" content={strings.ogLocale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${app.name} — Haug & Datter`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    {/* Smart App Banner i Safari på iOS. Kun for apper som er live. */}
    {storeId && <meta name="apple-itunes-app" content={`app-id=${storeId}`} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{pageTitle}</title>
    {/* Uten JavaScript får .reveal aldri is-in. Da skal alt bare vises. */}
    <noscript><style>.reveal, .stagger > * { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>
  <body>
    <div class="sweep" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>

    <AppMenu />

    <div class="theme-root" data-app={app.slug} style={`--accent:${app.accent}`}>
      <div class="app-backdrop" aria-hidden="true"></div>
      <div class="stage">
        <slot />
      </div>
    </div>

    <div class="kbd-hint" aria-hidden="true">
      {strings.kbdHint.press} <kbd>1</kbd>–<kbd>9</kbd> {strings.kbdHint.forApp} · <kbd>⌘K</kbd> {strings.kbdHint.search} · <kbd>Esc</kbd> {strings.kbdHint.home}
    </div>

    <script>
      import('../scripts/main.ts');
    </script>
  </body>
</html>
